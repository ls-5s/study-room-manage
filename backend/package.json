{
  "name": "study-room-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "system:check": "tsx scripts/check-system-config.ts",
    "db:prepare": "tsx scripts/prepare-database.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:seed": "tsx scripts/seed-admin.ts",
    "db:seed:rooms": "tsx scripts/seed-study-rooms.ts",
    "db:seed:feedback": "tsx scripts/seed-feedback.ts",
    "db:seed:statistics": "tsx scripts/seed-statistics.ts",
    "test": "tsx --test test/study-room.unit.test.ts test/reservation.unit.test.ts test/violation.unit.test.ts test/feedback.unit.test.ts test/statistics.unit.test.ts test/system.unit.test.ts",
    "jobs:reservation-state": "tsx scripts/run-reservation-job.ts",
    "violations:reconcile": "tsx scripts/reconcile-violations.ts",
    "sessions:cleanup": "tsx scripts/cleanup-sessions.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "express-validator": "7.3.2",
    "jsonwebtoken": "9.0.3",
    "mysql2": "3.24.6",
    "sequelize": "6.37.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
