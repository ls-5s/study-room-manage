# Run pnpm db:prepare to generate a local application password and create the project database.
HOST=127.0.0.1
PORT=43080
NODE_ENV=development
CORS_ORIGINS=http://localhost:43081,http://127.0.0.1:43081
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=study_room_manage
DB_USER=study_room_app
DB_PASSWORD=
DB_CONNECT_TIMEOUT_MS=5000
DB_ACQUIRE_TIMEOUT_MS=5000
DB_PROBE_TIMEOUT_MS=10000
# Used only by the explicit database preparation command.
MYSQL_CONTAINER=mysql8
