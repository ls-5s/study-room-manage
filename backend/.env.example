# Run pnpm db:prepare to generate a local application password and create the project database.
HOST=127.0.0.1
PORT=43080
NODE_ENV=development
CORS_ORIGINS=http://localhost:43081,http://127.0.0.1:43081
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=study_room_manage
DB_USER=study_room_app
DB_PASSWORD=
DB_CONNECT_TIMEOUT_MS=5000
DB_ACQUIRE_TIMEOUT_MS=5000
DB_PROBE_TIMEOUT_MS=10000
# Used only by the explicit database preparation command.
MYSQL_CONTAINER=mysql8
JWT_SECRET=
JWT_EXPIRES_IN=2h
# Optional; when empty it is derived from JWT_SECRET. Must be at least 32 bytes.
CHECK_IN_SIGNING_SECRET=
BCRYPT_COST=12
LOG_LEVEL=info
# Number of trusted reverse-proxy hops; 0 disables proxy trust.
TRUST_PROXY=0
JOBS_ENABLED=true
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_STUDENT_NO=
ADMIN_DISPLAY_NAME=
DEMO_STUDENT_USERNAME=feedback_demo
DEMO_STUDENT_STUDENT_NO=DEMO26001
DEMO_STUDENT_DISPLAY_NAME=演示同学
# 首次执行 db:seed:feedback 时会自动生成并写入本地 .env
DEMO_STUDENT_PASSWORD=
DEMO_ADMIN_USERNAME=feedback_admin
DEMO_ADMIN_STUDENT_NO=DEMOADMIN01
DEMO_ADMIN_DISPLAY_NAME=反馈演示管理员
DEMO_ADMIN_PASSWORD=
